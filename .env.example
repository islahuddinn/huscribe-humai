# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# --- Server ---
PORT=5001
NODE_ENV=development

# --- JWT ---
JWT_SECRET=your_jwt_secret_here

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx
STRIPE_BASIC_PRICE_ID=price_xxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxx
STRIPE_FREE_TRIAL_PRICE_ID=price_xxxxxx
STRIPE_S_ADDITIONAL_VOICE_PRICE_ID=price_xxxxxx
STRIPE_S_ADDITIONAL_MEETING_PRICE_ID=price_xxxxxx

# --- Email ---
SENDGRID_API_KEY=SG.xxxxxx
EMAIL_FROM=your_email@example.com

# --- Frontend ---
FRONTEND_URL=http://localhost:3002
FREE_TRIAL_QUOTA=100
SOCKET_ALLOWED_ORIGINS=*

# --- Firebase (provide path to your downloaded service account JSON) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./path-to-your-firebase-adminsdk.json
# OR inline JSON (not recommended):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Salesforce ---
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_sf_client_id
SF_CLIENT_SECRET=your_sf_client_secret
SF_REDIRECT_URI=http://localhost:5173/dashboard
SF_REDIRECT_AUTH_URI=https://your-domain.com/api/auth/salesforce/oauth/callback

# --- Zoom ---
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost:5001/api/meetings/zoom/callback

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/users/google/callback
GOOGLE_CALLBACK_URL=https://your-domain.com/api/users/google/callback

# --- Zoho CRM ---
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=https://your-domain.com/api/zoho/auth/callback
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CRM_API_URL=https://www.zohoapis.com/crm/v2
ZOHO_FRONTEND_URL=http://localhost:3002/auth/zoho

# --- HubSpot ---
HUBSPOT_API_KEY=your_hubspot_api_key
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_OAUTH_REDIRECT_URI=https://your-domain.com/api/hubspot/oauth/callback
HUBSPOT_REDIRECT_URI=http://localhost:5001/api/hubspot/oauth/callback
HUBSPOT_BASE_URL=https://app.hubspot.com
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_PORTAL_ID=your_portal_id

# --- Microsoft Dynamics CRM ---
MD_CLIENT_ID=your_md_client_id
MD_CLIENT_SECRET=your_md_client_secret
MD_FRONTEND_URL=http://localhost:3002/auth/dynamic
MD_REDIRECT_URI=https://your-domain.com/api/dynamic/callback
MD_ORG_URL=https://your-org.crm.dynamics.com
TENANT_ID=common
AZURE_TENANT_TYPE=common
DYNAMICS_SCOPE=https://your-org.crm.dynamics.com/user_impersonation
DYNAMICS_CRM_URL=https://your-org.crm.dynamics.com
STATE_SECRET=your_state_secret_here
DYNAMICS_LEAD_ENTITY=leads
DEFAULT_CURRENCY_ID=your-currency-guid
DYNAMICS_OPPORTUNITY_ENTITY=opportunities

# --- Microsoft Graph ---
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback

# --- Microsoft Login ---
MICROSOFT_LOGIN_CLIENT_ID=your_microsoft_login_client_id
MICROSOFT_LOGIN_CLIENT_SECRET=your_microsoft_login_client_secret
MICROSOFT_LOGIN_TENANT_ID=your_tenant_id
MICROSOFT_LOGIN_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback

# --- Asana ---
ASANA_ACCESS_TOKEN=your_asana_access_token
ASANA_CLIENT_ID=your_asana_client_id
ASANA_CLIENT_SECRET=your_asana_client_secret
ASANA_CALLBACK_URL=https://your-domain.com/api/asana/oauth/callback

# --- Trello ---
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_api_secret
TRELLO_TOKEN=your_trello_token
TRELLO_CLIENT_ID=your_trello_client_id
TRELLO_CLIENT_SECRET=your_trello_client_secret
TRELLO_CALLBACK_URL=http://localhost:5001/api/trello/callback

# --- Slack ---
SLACK_PORT=3000
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
VERIFICATION_TOKEN=your_slack_verification_token
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# --- Calendly ---
CALENDLY_CLIENT_ID=your_calendly_client_id
CALENDLY_CLIENT_SECRET=your_calendly_client_secret
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_secret
CALENDLY_REDIRECT_URI=http://localhost:5001/test-calendly

# --- Mailchimp ---
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=us8
MAILCHIMP_LIST_ID=your_list_id

# --- Apollo ---
APOLLO_API_KEY=your_apollo_api_key

# --- Chili Piper ---
CHILI_PIPER_WORKSPACE_ID=your_workspace_id
CHILI_PIPER_WEBHOOK_SECRET=your_webhook_secret
CHILI_PIPER_WEBHOOK_URL=https://your-domain.com/api/chilipiper/webhook
CHILI_PIPER_WEBHOOK_SIGNATURE=your_signature

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/linkedin/callback

# --- Freshsales ---
FRESHSALES_CLIENT_ID=your_freshsales_client_id
FRESHSALES_CLIENT_SECRET=your_freshsales_client_secret
FRESHSALES_REDIRECT_URI=https://your-domain.com/api/freshsales/auth/callback
FRESHSALES_BASE_URL=https://your-org.myfreshworks.com/crm/sales
SESSION_SECRET=your_strong_session_secret
FRESHSALES_FRONTEND_URL=http://localhost:3002

# --- ClickUp ---
CLICKUP_CLIENT_ID=your_clickup_client_id
CLICKUP_CLIENT_SECRET=your_clickup_client_secret
CLICKUP_REDIRECT_URI=https://your-domain.com/api/clickup/callback

# --- Monday.com ---
MONDAY_APP_ID=your_monday_app_id
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_OAUTH_URL=https://auth.monday.com/oauth2/authorize
MONDAY_TOKEN_URL=https://auth.monday.com/oauth2/token
MONDAY_CLIENT_ID=your_monday_client_id
MONDAY_CLIENT_SECRET=your_monday_client_secret
MONDAY_SIGNING_SECRET=your_monday_signing_secret
MONDAY_REDIRECT_URI=http://localhost:5001/api/monday/callback

# --- Acuity ---
ACUITY_OAUTH_CLIENT_ID=your_acuity_client_id
ACUITY_OAUTH_CLIENT_SECRET=your_acuity_client_secret
ACUITY_OAUTH_REDIRECT_URI=http://localhost:5001/api/acuity/oauth/callback

# --- Doodle ---
DOODLE_API_KEY=your_doodle_api_key
DOODLE_CLIENT_ID=your_doodle_client_id
DOODLE_CLIENT_SECRET=your_doodle_client_secret
DOODLE_API_BASE_URL=https://doodle.com/api/v2.0
DOODLE_AUTH_URL=https://doodle.com/oauth/authorize
DOODLE_TOKEN_URL=https://doodle.com/oauth/token
DOODLE_REDIRECT_URI=http://localhost:5001/api/doodle/callback

# --- Google Play IAP ---
GOOGLE_SERVICE_ACCOUNT_PATH=./path-to-your-google-play-service-account.json
GOOGLE_PACKAGE_NAME=com.huscribe.app

# --- Apple App Store Connect ---
APPLE_KEY_ID=your_apple_key_id
APPLE_ISSUER_ID=your_apple_issuer_id
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APPLE_BUNDLE_ID=com.huscribe.app
APPLE_SHARED_SECRET=your_apple_shared_secret

# --- Apple Sign In ---
APPLE_CLIENT_ID=your.app.bundle.id
APPLE_REDIRECT_URI=https://your-domain.com/auth/apple-auth-callback
APPLE_TEAM_ID=your_apple_team_id

# --- Corteza CRM ---
CORTEZA_BASE_URL=http://localhost:18080
CORTEZA_CLIENT_ID=your_corteza_client_id
CORTEZA_CLIENT_SECRET=your_corteza_client_secret
CORTEZA_ADMIN_EMAIL=admin@yourdomain.com
CORTEZA_ADMIN_PASSWORD=your_admin_password
CRM_BASE_URL=http://localhost:18080
